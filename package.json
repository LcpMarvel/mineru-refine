{
  "name": "mineru-refine",
  "version": "0.5.1",
  "description": "MinerU output linter/fixer — LLM tool-use loop that restructures (never generates) MinerU content_list to be closer to the source document. Machine-verified fidelity: C_out ⊆ C_in.",
  "type": "module",
  "license": "MIT",
  "author": "LcpMarvel <lcpmarvel@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LcpMarvel/mineru-refine.git"
  },
  "homepage": "https://github.com/LcpMarvel/mineru-refine#readme",
  "bugs": {
    "url": "https://github.com/LcpMarvel/mineru-refine/issues"
  },
  "keywords": [
    "mineru",
    "pdf",
    "content-list",
    "document-parsing",
    "postprocess",
    "linter",
    "llm",
    "deepseek",
    "qwen-vl",
    "bun"
  ],
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "mineru-refine": "src/cli.ts",
    "mineru-refine-server": "src/server.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "m0": "bun run scripts/m0_smoke.ts",
    "m0:vl": "bun run scripts/qwen_smoke.ts",
    "mineru:fetch": "bun run scripts/mineru_fetch.ts",
    "refine:real": "bun run scripts/refine_real.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "server": "bun run src/server.ts",
    "cli": "bun run src/cli.ts",
    "prepublishOnly": "bun test && bunx tsc --noEmit"
  },
  "dependencies": {
    "safe-json-repair": "^0.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
